<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name       "gpu-unlock">
  <!ENTITY author     "EEEEgoose">
  <!ENTITY version    "2026.10.27a">
  <!ENTITY md5        "5b85354ed5fdc6bcda03cfe1263a6f16">
  <!ENTITY launch     "Settings/GPUUnlock">
  <!ENTITY repo       "https://github.com/&author;/unlockGPU4Unraid">
  <!ENTITY pluginURL  "https://raw.githubusercontent.com/&author;/unlockGPU4Unraid/main/&name;.plg">
  <!ENTITY plugin     "/boot/config/plugins/&name;">
  <!ENTITY packages   "/boot/config/plugins/&name;/packages">
  <!ENTITY emhttp     "/usr/local/emhttp/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="&repo;/issues" icon="gpu-unlock.png" min="7.3.0">

<CHANGES>
###2026.10.27a
- 新增 Turing 显卡（RTX 2080 Ti 等 TU102/TU104/TU106）解锁，基于 nlzy/turing-unlock。页面会按显卡型号自动选用 gpu-unlock 或 turing-unlock，开机时两者都在 NVIDIA 加载前完成。
- turing-unlock 的模块包和固件包同样需要在本机用 Docker 编译；只编译其中一个也可以，没有包的显卡会跳过解锁。
- turing-unlock 较新，作者只在 Dell RTX 2080 Ti 22GB 上测试过，解锁后功耗很高，请谨慎使用。
- 显卡改按 GPU UUID 选择：开机解锁前核对该地址上的显卡型号，NVIDIA 加载后核对 UUID，不符时只发通知并停用这项选择。之前版本保存的选择需要重新勾选。

###2026.10.27
- 支持在 Unraid 中检查和安装插件更新：UI 包从 GitHub Releases 下载并校验 MD5，缓存在 U 盘上，之后离线启动也能使用。
- 模块包和固件包仍需在本机用 Docker 编译，见仓库中的 docs/build-docker.md。
- 启动规则写入 U 盘失败时，保存会如实报告失败，不再提示“已安排解锁”；settings.cfg 写入失败时也会提示。
- 当前驱动一栏显示驱动版本号；底部按钮放在同一排并居中；页面底部注明基于 Zagitta/gpu-unlock 开发。
- 图标改为透明背景。

###2026.10.25a
- 新图标；不可解锁的显卡只显示原因。

###2026.10.25
- 首个本地验证版本：开机在 NVIDIA 接管前解锁选定的 Ampere 显卡，逐卡记录结果。
</CHANGES>

<!--
The UI package is downloaded once from the GitHub release and kept on the flash; the module and
firmware packages of gpu-unlock and turing-unlock are built locally (docs/build-docker.md). At boot every package comes from
&packages;, so the boot never waits for the network. rc.local installs this plugin before
nvidia-driver.plg; see docs/boot-integration.md.
-->
<FILE Run="/bin/bash">
<INLINE>
# Keep only this version's UI package on the flash.
for old in &packages;/gpu-unlock-ui-*.txz; do
  case $old in *-ui-&version;-x86_64-*) ;; *) rm -f "$old" ;; esac
done
</INLINE>
</FILE>

<FILE Name="&packages;/gpu-unlock-ui-&version;-x86_64-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>&repo;/releases/download/&version;/gpu-unlock-ui-&version;-x86_64-1.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
KERNEL=$(uname -r)
KTAG=$(echo "$KERNEL" | tr - _)
installed=no
# Each unlock module is optional: cards without their packages skip the unlock.
for p in gpu-unlock turing-unlock; do
  kmod=$(ls &packages;/$p-kmod-*_${KTAG}-x86_64-*.txz 2>/dev/null | tail -n 1)
  fw=$(ls &packages;/$p-firmware-*-noarch-*.txz 2>/dev/null | tail -n 1)
  if [ -n "$kmod" ] &amp;&amp; [ -n "$fw" ]; then
    upgradepkg --install-new --reinstall "$fw"
    upgradepkg --install-new --reinstall "$kmod"
    installed=yes
  else
    echo "gpu-unlock: no $p module or firmware package for kernel $KERNEL; its cards skip the unlock (see &repo;/blob/main/docs/build-docker.md)"
  fi
done
[ $installed = yes ] &amp;&amp; depmod -a "$KERNEL"

if [ ! -f &plugin;/settings.cfg ]; then
  printf 'enabled="no"\ntargets=""\n' > &plugin;/settings.cfg
fi

# Unlock and hand the cards to NVIDIA. Does nothing when disabled or already run this boot.
/usr/local/sbin/gpu-unlock-control boot
echo "gpu-unlock: $(/usr/local/sbin/gpu-unlock-control status | tr -d '\n' | tr -s ' ')"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Undo only this plugin's boot changes; the card state already applied stays until power off.
/usr/local/sbin/gpu-unlock-control disable
for pkg in gpu-unlock-kmod gpu-unlock-firmware turing-unlock-kmod turing-unlock-firmware gpu-unlock-ui; do
  removepkg "$pkg" 2>/dev/null
done
depmod -a "$(uname -r)"
rm -rf &emhttp; &plugin; /var/run/gpu-unlock
echo "gpu-unlock removed; reboot for NVIDIA to load as before, power off to relock the cards"
</INLINE>
</FILE>

</PLUGIN>
