#!/bin/bash
# gpu-unlock-control: boot coordination, inspection and status for the gpu-unlock plugin.
# See docs/boot-integration.md for the boot chain this implements.
set -u

PLUGIN_DIR=${GPU_UNLOCK_PLUGIN_DIR:-/boot/config/plugins/gpu-unlock}
CFG=$PLUGIN_DIR/settings.cfg
PKG_DIR=$PLUGIN_DIR/packages
BOOT_MODPROBE=${GPU_UNLOCK_BOOT_MODPROBE:-/boot/config/modprobe.d}
ETC_MODPROBE=${GPU_UNLOCK_ETC_MODPROBE:-/etc/modprobe.d}
SYSFS_PCI=${GPU_UNLOCK_SYSFS_PCI:-/sys/bus/pci/devices}
SYSFS_MODULE=${GPU_UNLOCK_SYSFS_MODULE:-/sys/module}
BOOT_ID_FILE=${GPU_UNLOCK_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}
RUN_DIR=${GPU_UNLOCK_RUN_DIR:-/var/run/gpu-unlock}
LOG=${GPU_UNLOCK_LOG:-/var/log/gpu-unlock.log}
KERNEL=${GPU_UNLOCK_KERNEL:-$(uname -r)}
NOTIFY=${GPU_UNLOCK_NOTIFY:-/usr/local/emhttp/webGui/scripts/notify}

# Persistent: keeps udev from autoloading nvidia before the unlock modules have run.
DEFER_CONF=$BOOT_MODPROBE/gpu-unlock.conf
# This boot only: refuses every later nvidia load after a fault that needs a power off.
BLOCK_CONF=$ETC_MODPROBE/gpu-unlock-block.conf
STATUS=$RUN_DIR/status.json
NVIDIA_MODULES="nvidia nvidia_uvm nvidia_modeset nvidia_drm nvidia_peermem"
T=$'\t'
NL=$'\n'

# The unlock modules, each with the device IDs it accepts: supported_ids in
# kernel/<module>/main.c of the pinned upstream (Zagitta/gpu-unlock, nlzy/turing-unlock).
UNLOCKERS="gpu_unlock turing_unlock"
IDS_gpu_unlock="2200 2203 2204 2205 2206 2207 2208 220a 220d 2216 222b 222f
2480 2482 2483 2484 2486 2487 2488 2489 248a 248c 248d 248e 249c 249d 249f 24a0
24a4 24ac 24ad 24af 24bf 24c0 24c7 24c8 24c9 24dc 24dd 24df 24e0
2414
2501 2503 2504 2505 2507 2508 2509 252f 2544"
IDS_turing_unlock="1e03 1e04 1e07 1e2d 1e2e
1e81 1e82 1e84 1e87 1e89 1ec2 1ec7
1f02 1f03 1f06 1f07 1f08 1f42 1f47"

# A selected card is saved as UUID@ADDRESS@VENDOR:DEVICE@SUBVENDOR:SUBDEVICE, for example
# GPU-377334bd-…@0000:c5:00.0@10de:2206@10de:146d. The UUID only exists once NVIDIA has
# the card, so before the unlock the card at ADDRESS is checked against the IDs, and the
# UUID is checked after NVIDIA has loaded. Identical cards differ only in their UUID.

log() {
  echo "$(date '+%F %T') $*" >> "$LOG"
}

# Reads one key from settings.cfg as data; the file is never sourced.
cfg_get() {
  local line
  [ -f "$CFG" ] || return 0
  line=$(grep -E "^$1=" "$CFG" | tail -n 1)
  line=${line#*=}
  line=${line#\"}
  line=${line%\"}
  printf '%s' "$line"
}

cfg_write() {
  mkdir -p "$PLUGIN_DIR"
  printf 'enabled="%s"\ntargets="%s"\n' "$1" "$2" > "$CFG.tmp" && mv "$CFG.tmp" "$CFG"
}

# The saved cards, one per line.
entries() {
  cfg_get targets | tr , '\n' | grep -v '^$'
}

entry_uuid() { printf '%s' "$1" | cut -d@ -f1; }
entry_pci() { printf '%s' "$1" | cut -d@ -f2; }
entry_ids() { printf '%s' "$1" | cut -d@ -f3-; }

# A full entry; an address alone was saved by plugin versions before 2026.10.27a.
entry_complete() {
  [ "$(printf '%s' "$1" | tr -cd @ | wc -c | tr -d ' ')" = 3 ]
}

pci_attr() {
  local value
  value=$(cat "$SYSFS_PCI/$1/$2" 2>/dev/null) || return 1
  printf '%s' "${value#0x}"
}

pci_driver() {
  [ -L "$SYSFS_PCI/$1/driver" ] && basename "$(readlink "$SYSFS_PCI/$1/driver")"
}

# VENDOR:DEVICE@SUBVENDOR:SUBDEVICE of the card at an address, as saved in an entry.
pci_ids() {
  printf '%s:%s@%s:%s' "$(pci_attr "$1" vendor)" "$(pci_attr "$1" device)" \
    "$(pci_attr "$1" subsystem_vendor)" "$(pci_attr "$1" subsystem_device)"
}

# The unlock module for a full PCI address of a supported NVIDIA card in this machine.
unlocker_for() {
  local device m ids
  echo "$1" | grep -Eq '^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$' || return 1
  [ "$(pci_attr "$1" vendor)" = 10de ] || return 1
  device=$(pci_attr "$1" device) || return 1
  for m in $UNLOCKERS; do
    ids=IDS_$m
    case " $(echo ${!ids}) " in *" $device "*) echo "$m"; return 0 ;; esac
  done
  return 1
}

supported() {
  unlocker_for "$1" > /dev/null
}

# "ADDRESS UUID" for every card NVIDIA drives, with addresses as in sysfs (0000:c5:00.0).
gpu_uuids() {
  nvidia-smi --query-gpu=pci.bus_id,uuid --format=csv,noheader 2> /dev/null |
    awk -F ', *' 'NF == 2 { a = tolower($1); sub(/^0000/, "", a); print a, $2 }'
}

boot_id() {
  cat "$BOOT_ID_FILE"
}

# Package files of one unlock module: gpu_unlock -> gpu-unlock-kmod-..., gpu-unlock-firmware-...
kmod_package() {
  ls "$PKG_DIR/$(echo "$1" | tr _ -)"-kmod-*_"$(echo "$KERNEL" | tr - _)"-x86_64-*.txz 2>/dev/null | tail -n 1
}

firmware_package() {
  ls "$PKG_DIR/$(echo "$1" | tr _ -)"-firmware-*-noarch-*.txz 2>/dev/null | tail -n 1
}

json_str() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

status_is_current() {
  [ -f "$STATUS" ] && grep -q "\"boot_id\": $(json_str "$(boot_id)")" "$STATUS"
}

# Status line for one card from the kernel log lines added by loading module $3.
# Prints "state<TAB>reason<TAB>power_off" (power_off is yes or no).
card_result() {
  local pci=$1 lines=$2 m=$3 mine reason
  mine=$(printf '%s\n' "$lines" | grep -F "$pci")
  if printf '%s\n' "$mine" | grep -q 'power off'; then
    reason=$(printf '%s\n' "$mine" | grep 'power off' | head -n 1 | sed "s/.*$pci: //")
    printf 'failed\t%s\tyes\n' "$reason"
  elif printf '%s\n' "$mine" | grep -q "$m: unlocked\$"; then
    printf 'unlocked\t\tno\n'
  elif reason=$(printf '%s\n' "$mine" | grep -o "$m: unlock failed ([-0-9]*)" | head -n 1) && [ -n "$reason" ]; then
    printf 'failed\t%s\tno\n' "${reason#$m: }"
  elif printf '%s\n' "$lines" | grep -qF "no supported card at \"$pci\""; then
    printf 'failed\tno supported card at this address\tno\n'
  elif reason=$(printf '%s\n' "$mine" | grep -o "$m: firmware load failed ([-0-9]*)" | head -n 1) && [ -n "$reason" ]; then
    printf 'failed\t%s\tno\n' "${reason#$m: }"
  elif printf '%s\n' "$lines" | grep -q "$m: firmware load failed"; then
    printf 'failed\tfirmware load failed\tno\n'
  else
    printf 'failed\tno result in kernel log\tno\n'
  fi
}

# The NVIDIA modules udev would load for the NVIDIA display devices, were they
# not blacklisted. modprobe -R ignores the blacklist; nouveau and nvidiafb are left out.
alias_modules() {
  local dev m
  for dev in "$SYSFS_PCI"/*; do
    [ "$(pci_attr "$(basename "$dev")" vendor)" = 10de ] || continue
    case $(pci_attr "$(basename "$dev")" class) in 03*) ;; *) continue ;; esac
    modprobe -R "$(cat "$dev/modalias" 2>/dev/null)" 2>/dev/null
  done | sort -u | while read -r m; do
    case " $NVIDIA_MODULES " in *" $m "*) echo "$m" ;; esac
  done
}

# Hands the cards to NVIDIA as udev would have, unless nvidia is already loaded
# or its package is not installed yet (the NVIDIA Driver plugin then installs and loads it).
load_nvidia() {
  local m mods
  if [ -d "$SYSFS_MODULE/nvidia" ]; then
    return 0
  fi
  if ! modinfo -k "$KERNEL" nvidia > /dev/null 2>&1; then
    log "boot: nvidia module not installed yet; left to the NVIDIA Driver plugin"
    return 0
  fi
  mods=$(alias_modules)
  for m in ${mods:-nvidia}; do
    if modprobe "$m"; then
      log "boot: $m loaded"
    else
      log "boot: modprobe $m failed ($?)"
    fi
  done
}

notify() {
  log "notify: $1: $2"
  [ -x "$NOTIFY" ] && "$NOTIFY" -e "GPU Unlock" -s "$1" -i alert -d "$2" -l "/Settings/GPUUnlock"
  return 0
}

block_nvidia() {
  local m
  mkdir -p "$ETC_MODPROBE"
  {
    echo "# gpu-unlock: a card needs a power off before NVIDIA may use it (this boot only)"
    for m in $NVIDIA_MODULES; do
      echo "install $m /bin/false"
    done
  } > "$BLOCK_CONF"
  log "boot: NVIDIA loading blocked for this boot; power the server off before using the GPUs"
  notify "Power off required" "An unlock module reported a fault that needs a power off. NVIDIA was not loaded this boot."
}

# Removes saved cards (entries in $1, one per line) from the selection, so the next
# boot does not unlock them; with none left the unlock is disabled altogether.
drop_entries() {
  local keep
  keep=$(entries | grep -vxF "$1" | paste -sd , -)
  if [ -n "$keep" ]; then
    cfg_write yes "$keep"
  else
    cfg_write no ""
    rm -f "$DEFER_CONF"
  fi
}

cmd_inspect() {
  local dev bdf class id driver selected model uuid uuids e m
  uuids=$(gpu_uuids)
  for dev in "$SYSFS_PCI"/*; do
    bdf=$(basename "$dev")
    [ "$(pci_attr "$bdf" vendor)" = 10de ] || continue
    class=$(pci_attr "$bdf" class)
    case $class in 03*) ;; *) continue ;; esac
    id=10de:$(pci_attr "$bdf" device)
    driver=$(pci_driver "$bdf")
    [ -n "$driver" ] && [ -r "$SYSFS_MODULE/$driver/version" ] && driver="$driver $(cat "$SYSFS_MODULE/$driver/version")"
    uuid=$(printf '%s\n' "$uuids" | awk -v a="$bdf" '$1 == a { print $2 }')
    # Selected when a saved card has this UUID, or this address if NVIDIA does not drive it.
    selected=no
    for e in $(entries); do
      if [ -n "$uuid" ] && [ "$(entry_uuid "$e")" = "$uuid" ]; then selected=yes; fi
      if [ -z "$uuid" ] && [ "$(entry_pci "$e")" = "$bdf" ]; then selected=yes; fi
    done
    # "cc:00.0 VGA compatible controller: NVIDIA Corporation GA102 [...]" -> after the class name
    model=$(lspci -s "$bdf" 2>/dev/null | sed 's/^[^ ]* [^:]*: //')
    # gpu<TAB>address<TAB>PCI ID<TAB>module|no<TAB>driver<TAB>selected<TAB>model<TAB>UUID<TAB>entry to save
    printf 'gpu\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$bdf" "$id" "$(unlocker_for "$bdf" || echo no)" \
      "${driver:-none}" "$selected" "$model" "$uuid" "${uuid:+$uuid@$bdf@$(pci_ids "$bdf")}"
  done
  printf 'kernel\t%s\n' "$KERNEL"
  # package<TAB>module<TAB>kmod file<TAB>firmware file<TAB>installed module path
  for m in $UNLOCKERS; do
    printf 'package\t%s\t%s\t%s\t%s\n' "$m" "$(basename "$(kmod_package "$m")" 2>/dev/null)" \
      "$(basename "$(firmware_package "$m")" 2>/dev/null)" "$(modinfo -k "$KERNEL" -n "$m" 2>/dev/null || echo missing)"
  done
  printf 'deferred\t%s\n' "$([ -f "$DEFER_CONF" ] && echo yes || echo no)"
  printf 'blocked\t%s\n' "$([ -f "$BLOCK_CONF" ] && echo yes || echo no)"
}

cmd_prepare_boot() {
  local e pci m
  if [ "$(cfg_get enabled)" != yes ]; then
    rm -f "$DEFER_CONF"
    echo "unlock disabled for the next boot"
    return 0
  fi
  if [ -z "$(entries)" ]; then
    echo "no target selected" >&2
    return 1
  fi
  for e in $(entries); do
    if ! entry_complete "$e"; then
      echo "$e was saved by an older version; select the card again" >&2
      return 1
    fi
    pci=$(entry_pci "$e")
    if ! m=$(unlocker_for "$pci") || [ "$(pci_ids "$pci")" != "$(entry_ids "$e")" ]; then
      echo "$(entry_uuid "$e") is not a supported card at $pci" >&2
      return 1
    fi
    if [ -z "$(kmod_package "$m")" ] || [ -z "$(firmware_package "$m")" ]; then
      echo "no $m module or firmware package for kernel $KERNEL in $PKG_DIR (needed by $pci)" >&2
      return 1
    fi
  done
  # Written whole or not at all: without this rule NVIDIA binds before the unlock.
  if ! mkdir -p "$BOOT_MODPROBE" || ! {
    echo "# gpu-unlock: nvidia is loaded by gpu-unlock-control boot once the unlock has run"
    for m in $NVIDIA_MODULES; do
      echo "blacklist $m"
    done
  } > "$DEFER_CONF.tmp" || ! mv "$DEFER_CONF.tmp" "$DEFER_CONF"; then
    rm -f "$DEFER_CONF.tmp"
    echo "cannot write $DEFER_CONF; unlock not scheduled" >&2
    return 1
  fi
  log "prepare-boot: unlock of $(entries | cut -d@ -f1,2 | paste -sd ' ' -) scheduled for the next boot"
  echo "unlock of $(entries | cut -d@ -f2 | paste -sd , -) scheduled for the next boot"
}

# Loads unlock module $1 once for the cards in $2 (comma separated) and appends
# one line per card to $results, setting power_off=yes on a fault that needs it.
run_unlocker() {
  local m=$1 list=$2 pci result before lines rc=0
  if ! modinfo -k "$KERNEL" "$m" > /dev/null 2>&1; then
    for pci in $(echo "$list" | tr , ' '); do
      results="$results$pci${T}skipped${T}no $m package for kernel $KERNEL${T}no$T$m$NL"
    done
    return 0
  fi
  before=$(dmesg | wc -l)
  log "boot: modprobe $m targets=$list"
  modprobe "$m" targets="$list" || rc=$?
  lines=$(dmesg | tail -n +$((before + 1)) | grep -E "$m|power off|WPR2")
  [ -n "$lines" ] && printf '%s\n' "$lines" >> "$LOG"
  for pci in $(echo "$list" | tr , ' '); do
    result=$(card_result "$pci" "$lines" "$m")
    if [ $rc -ne 0 ] && [ ! -d "$SYSFS_MODULE/$m" ] && \
       [ "$(printf '%s' "$result" | cut -f2)" = "no result in kernel log" ]; then
      result=$(printf 'skipped\t%s failed to load (%s)\tno' "$m" "$rc")
    fi
    results="$results$pci$T$result$T$m$NL"
    [ "$(printf '%s' "$result" | cut -f3)" = yes ] && power_off=yes
  done
}

cmd_boot() {
  local id e pci m list uuid actual uuids saved candidates="" results="" checks="" dropped="" power_off=no
  mkdir -p "$RUN_DIR"
  id=$(boot_id)
  if status_is_current; then
    log "boot: already ran for this boot"
    return 0
  fi
  if [ "$(cfg_get enabled)" != yes ]; then
    # Only undo a deferral this plugin caused.
    [ -f "$ETC_MODPROBE/gpu-unlock.conf" ] && load_nvidia
    return 0
  fi
  saved=$(entries)

  # Before the unlock: only cards whose address still holds the saved kind of card.
  # checks: entry<TAB>state (empty keeps the unlock result)<TAB>reason or note
  for e in $saved; do
    if ! entry_complete "$e"; then
      checks="$checks$e${T}skipped${T}saved by an older version without the card's UUID; select the card again$NL"
      dropped="$dropped$e$NL"
      continue
    fi
    pci=$(entry_pci "$e")
    if ! supported "$pci" || [ "$(pci_ids "$pci")" != "$(entry_ids "$e")" ]; then
      checks="$checks$e${T}skipped${T}the card at $pci changed (saved $(entry_ids "$e"), found $(pci_ids "$pci")); select the card again$NL"
      dropped="$dropped$e$NL"
    elif [ -n "$(pci_driver "$pci")" ]; then
      checks="$checks$e${T}skipped_bound${T}bound to $(pci_driver "$pci")$NL"
    else
      candidates="$candidates $pci"
    fi
  done

  # One load per module, each finishing its cards before the next and before NVIDIA.
  for m in $UNLOCKERS; do
    list=""
    for pci in $candidates; do
      [ "$(unlocker_for "$pci")" = "$m" ] && list="$list${list:+,}$pci"
    done
    [ -n "$list" ] && run_unlocker "$m" "$list"
  done

  if [ $power_off = yes ]; then
    block_nvidia
  else
    load_nvidia
  fi

  # After NVIDIA: the unlocked card must be the selected one, which only its UUID tells.
  uuids=""
  [ $power_off = yes ] || uuids=$(gpu_uuids)
  for e in $saved; do
    entry_complete "$e" || continue
    pci=$(entry_pci "$e")
    uuid=$(entry_uuid "$e")
    [ "$(printf '%s' "$results" | awk -F '\t' -v a="$pci" '$1 == a { print $2 }')" = unlocked ] || continue
    actual=$(printf '%s\n' "$uuids" | awk -v a="$pci" '$1 == a { print $2 }')
    if [ -z "$actual" ]; then
      checks="$checks$e${T}${T}UUID not verified: NVIDIA does not report the card at $pci$NL"
    elif [ "$actual" != "$uuid" ]; then
      checks="$checks$e${T}wrong_card${T}the card at $pci is $actual, not the selected $uuid; select the card again$NL"
      dropped="$dropped$e$NL"
    fi
  done

  if [ -n "$dropped" ]; then
    drop_entries "$(printf '%s' "$dropped")"
    notify "Card selection disabled" "$(printf '%s' "$checks" | awk -F '\t' '$2 == "skipped" || $2 == "wrong_card" { print $3 }' | paste -sd ' ' -)"
  fi

  {
    printf '{\n  "boot_id": %s,\n  "kernel": %s,\n  "power_off_required": %s,\n  "targets": [' \
      "$(json_str "$id")" "$(json_str "$KERNEL")" "$([ $power_off = yes ] && echo true || echo false)"
    # R: unlock results by address; U: the saved UUID of each address; C: checks by
    # saved entry, which override the unlock result.
    {
      printf '%s' "$results" | sed "s/^/R$T/"
      for e in $saved; do
        entry_complete "$e" && printf 'U%s%s%s%s\n' "$T" "$(entry_pci "$e")" "$T" "$(entry_uuid "$e")"
      done
      printf '%s' "$checks" | sed "s/^/C$T/"
    } |
      awk -F '\t' -v q='"' '
      function s(v) { gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v); return q v q }
      function add(p) { if (!(p in seen)) { seen[p] = 1; order[++c] = p } }
      $1 == "R" { add($2); state[$2] = $3; reason[$2] = $4; unl[$2] = $6; next }
      $1 == "U" { uuid[$2] = $3; next }
      $1 == "C" { n = split($2, f, "@"); p = (n == 4) ? f[2] : $2; add(p)
                  if (n == 4) uuid[p] = f[1]
                  if ($3 != "") { state[p] = $3; reason[p] = $4 } else note[p] = $4 }
      END { for (i = 1; i <= c; i++) { p = order[i]
              printf "%s\n    {\"pci\": %s, \"state\": %s", (i > 1 ? "," : ""), s(p), s(state[p])
              if (uuid[p] != "") printf ", \"uuid\": %s", s(uuid[p])
              if (unl[p] != "") printf ", \"unlocker\": %s", s(unl[p])
              if (reason[p] != "") printf ", \"reason\": %s", s(reason[p])
              if (note[p] != "") printf ", \"note\": %s", s(note[p])
              printf "}" }
            if (c) printf "\n  " }'
    printf ']\n}\n'
  } > "$STATUS.tmp" && mv "$STATUS.tmp" "$STATUS"
  log "boot: $(printf '%s' "$results" | awk -F '\t' 'NF { printf "%s%s=%s", (n++ ? " " : ""), $1, $2 }')"
}

cmd_status() {
  local e state first=1
  if status_is_current; then
    cat "$STATUS"
    return 0
  fi
  [ "$(cfg_get enabled)" = yes ] && state=pending || state=disabled
  printf '{\n  "boot_id": %s,\n  "kernel": %s,\n  "power_off_required": false,\n  "targets": [' \
    "$(json_str "$(boot_id)")" "$(json_str "$KERNEL")"
  for e in $(entries); do
    [ $first = 1 ] || printf ','
    if entry_complete "$e"; then
      printf '\n    {"pci": %s, "state": "%s", "uuid": %s}' "$(json_str "$(entry_pci "$e")")" "$state" "$(json_str "$(entry_uuid "$e")")"
    else
      printf '\n    {"pci": %s, "state": "%s"}' "$(json_str "$e")" "$state"
    fi
    first=0
  done
  [ $first = 1 ] || printf '\n  '
  printf ']\n}\n'
}

cmd_disable() {
  cfg_write no "$(cfg_get targets)"
  rm -f "$DEFER_CONF" "$ETC_MODPROBE/gpu-unlock.conf"
  log "disable: unlock disabled for the next boot"
  echo "unlock disabled for the next boot"
}

case ${1:-} in
  inspect) cmd_inspect ;;
  prepare-boot) cmd_prepare_boot ;;
  boot) cmd_boot ;;
  status) cmd_status ;;
  disable) cmd_disable ;;
  *)
    echo "usage: $(basename "$0") inspect|prepare-boot|boot|status|disable" >&2
    exit 2
    ;;
esac
